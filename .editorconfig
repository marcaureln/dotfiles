root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[.gitconfig]
indent_style = tab

[claude/.claude/scripts/**.{ts,json}]
indent_style = tab

[config/.config/gh/*.yml]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
